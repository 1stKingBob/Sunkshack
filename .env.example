# Copy this file to .env.local and fill in ONE of the two keys below.
# Restart the dev server after editing — env vars are only read at startup.
#
# The app runs fine with no key at all. The key only enables the
# "Take or upload a photo" button; everything else (the demo room, dragging,
# the clearance checks, the Care Pass) works without one.
#
# These are read server-side only, inside api/analyze.ts, and never reach the
# browser. Do NOT rename them with a VITE_ prefix — that would bundle the key
# into the client where anyone can read it out of the network tab.

# Option 1 — Anthropic. Used first if both are set. console.anthropic.com
ANTHROPIC_API_KEY=

# Option 2 — Google Gemini. Easier free tier. aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional model overrides, only if the default is unavailable on your key.
# ANTHROPIC_MODEL=claude-sonnet-4-5
# GEMINI_MODEL=gemini-3.6-flash
