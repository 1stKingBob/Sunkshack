# Copy this file to .env.local and fill in ONE of the two keys below.
# Restart the dev server after editing — env vars are only read at startup.
#
# The app runs fine with no key at all. The key only enables the
# "Take or upload a photo" button; everything else (the demo room, dragging,
# the clearance checks, the Care Pass) works without one.
#
# These are read server-side only, inside api/analyze.ts, and never reach the
# browser. Do NOT rename them with a VITE_ prefix — that would bundle the key
# into the client where anyone can read it out of the network tab.

# Option 1 — Anthropic. Used first if both are set. console.anthropic.com
ANTHROPIC_API_KEY=

# Option 2 — Google Gemini. Easier free tier. aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional model overrides, only if the default is unavailable on your key.
# ANTHROPIC_MODEL=claude-sonnet-4-5
# GEMINI_MODEL=gemini-3.6-flash

# ── Community (map + scores) ─────────────────────────────────────────────────
# These three ARE bundled into the browser, deliberately: the community screen
# talks to Google and Supabase directly with no server in between. The Supabase
# value must be the public "anon" key, never the service-role key — it is only
# safe because Row Level Security is on (see supabase/schema.sql). Restrict the
# Maps key by HTTP referrer in the Google Cloud console.
#
# Without the Maps key the community screen falls back to a sample list.

# Google Cloud Console → APIs & Services → Library → enable BOTH:
#   • Maps JavaScript API
#   • Places API (New)          ← the "(New)" one. The legacy Places API cannot
#                                 be enabled on projects created after 1 Mar 2025.
# If you add an HTTP-referrer restriction to the key it must include
# http://localhost:5173/*  or the map will not load on your own machine.
VITE_GOOGLE_MAPS_API_KEY=

# Supabase project → Settings → API. Run supabase/schema.sql once first.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
